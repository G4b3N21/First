<svg xmlns="http://w3.org" viewBox="0 0 500 500" width="100%" height="100%">
  <defs>
    <!-- Sötét űr-háttér gradiens -->
    <radialGradient id="bgGrad" cx="50%" cy="50%" r="70%">
      <stop offset="0%" stop-color="#0a1128" />
      <stop offset="60%" stop-color="#020617" />
      <stop offset="100%" stop-color="#000000" />
    </radialGradient>

    <!-- Neon türkiz ragyogás effekt (Glow) -->
    <filter id="neonGlow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="5" result="blur1" />
      <feGaussianBlur stdDeviation="1.5" result="blur2" />
      <feMerge>
        <feMergeNode in="blur1" />
        <feMergeNode in="blur2" />
        <feMergeNode in="SourceGraphic" />
      </feMerge>
    </filter>

    <!-- Erős fehér neon ragyogás a fókusz elemeknek -->
    <filter id="whiteNeonGlow" x="-30%" y="-30%" width="160%" height="160%">
      <feGaussianBlur stdDeviation="4" result="blur1" />
      <feGaussianBlur stdDeviation="1" result="blur2" />
      <feMerge>
        <feMergeNode in="blur1" />
        <feMergeNode in="blur2" />
        <feMergeNode in="SourceGraphic" />
      </feMerge>
    </filter>

    <!-- Halványabb háttér-ragyogás a rácsvonalaknak -->
    <filter id="subtleGlow" x="-10%" y="-10%" width="120%" height="120%">
      <feGaussianBlur stdDeviation="2" result="blur" />
      <feMerge>
        <feMergeNode in="blur" />
        <feMergeNode in="SourceGraphic" />
      </feMerge>
    </filter>
  </defs>

  <!-- Profilkép alap / Háttér -->
  <rect width="500" height="500" fill="url(#bgGrad)" />

  <!-- ================= NAVIGÁCIÓS HUD RENDSZER ================= -->
  <g transform="translate(250, 250)">
    
    <!-- Külső finom célzókereszt gyűrű -->
    <circle r="225" fill="none" stroke="#00f2ff" stroke-width="1" stroke-opacity="0.15" stroke-dasharray="2 8" />
    
    <!-- Fő külső osztott gyűrű -->
    <circle r="195" fill="none" stroke="#00f2ff" stroke-width="1.5" filter="url(#neonGlow)" stroke-dasharray="140 20 40 20 90 15 30 15" />
    
    <!-- Másodlagos belső forgó gyűrű -->
    <circle r="165" fill="none" stroke="#00f2ff" stroke-width="1.25" stroke-opacity="0.4" filter="url(#subtleGlow)" stroke-dasharray="12 4" />
    <circle r="155" fill="none" stroke="#00f2ff" stroke-width="1" stroke-opacity="0.3" stroke-dasharray="220 10 60 10" />

    <!-- ================= HIGH-TECH SCI-FI HUD ADAT-GYŰRŰK ================= -->
    <g fill="none" stroke="#00f2ff" filter="url(#subtleGlow)">
      <circle r="35" stroke-width="1" stroke-opacity="0.25" stroke-dasharray="1 3" />
      <circle r="55" stroke-width="1" stroke-opacity="0.2" stroke-dasharray="30 10 5 10" />
      <circle r="75" stroke-width="2" stroke-opacity="0.3" stroke-dasharray="2 3" />
      <circle r="95" stroke-width="1" stroke-opacity="0.2" stroke-dasharray="80 10 20 10 5 5" />
      <circle r="115" stroke-width="0.75" stroke-opacity="0.1" stroke-dasharray="6 2" />
      
      <!-- A nagy, kitolt G betű fő íve (stroke-width="2.75") -->
      <path d="M 140,0 A 140,140 0 1,1 70,-121.24" stroke-width="2.75" stroke-opacity="0.85" filter="url(#neonGlow)" />
    </g>

    <!-- Iránytű főtengelyek -->
    <line x1="0" y1="-225" x2="0" y2="-175" stroke="#00f2ff" stroke-width="1.5" filter="url(#neonGlow)" />
    <line x1="0" y1="175" x2="0" y2="225" stroke="#00f2ff" stroke-width="1.5" filter="url(#neonGlow)" />
    <line x1="-225" y1="0" x2="-175" y2="0" stroke="#00f2ff" stroke-width="1.5" filter="url(#neonGlow)" />
    <line x1="175" y1="0" x2="225" y2="0" stroke="#00f2ff" stroke-width="1.5" filter="url(#neonGlow)" />

    <!-- DIGITÁLIS SKÁLA -->
    <g stroke="#00f2ff" stroke-width="1.25" opacity="0.4" filter="url(#subtleGlow)">
      <line x1="0" y1="-195" x2="0" y2="-187" transform="rotate(30)" />
      <line x1="0" y1="-195" x2="0" y2="-187" transform="rotate(60)" />
      <line x1="0" y1="-195" x2="0" y2="-187" transform="rotate(120)" />
      <line x1="0" y1="-195" x2="0" y2="-187" transform="rotate(150)" />
      <line x1="0" y1="-195" x2="0" y2="-187" transform="rotate(210)" />
      <line x1="0" y1="-195" x2="0" y2="-187" transform="rotate(240)" />
      <line x1="0" y1="-195" x2="0" y2="-187" transform="rotate(300)" />
      <line x1="0" y1="-195" x2="0" y2="-187" transform="rotate(330)" />
    </g>

    <!-- ================= AZ IRÁNYTŰ MUTATÓI ================= -->
    <g transform="rotate(90)">
      <!-- Északi fő mutató (Jobbra néz, lezárja a G-t) -->
      <polygon points="0,-140 12,-30 0,-15" fill="#00f2ff" filter="url(#neonGlow)" />
      <polygon points="0,-140 -12,-30 0,-15" fill="#00c8ff" opacity="0.7" filter="url(#neonGlow)" />
      
      <!-- VISSZAÁLLÍTVA: Déli kisebb mutató -> Az eredeti tömör sötétkék dizájn -->
      <polygon points="0,95 8,25 0,15" fill="#0066cc" opacity="0.8" />
      <polygon points="0,95 -8,25 0,15" fill="#0044aa" opacity="0.5" />
    </g>

    <!-- ================= KÖZPONTI MAG A FEHÉREN RAGYOGÓ "G" BETŰVEL ================= -->
    <circle r="15" fill="#020617" stroke="#00f2ff" stroke-width="2" filter="url(#neonGlow)" />
    <text x="-4" y="4" font-family="Courier New, monospace" font-size="11" font-weight="bold" fill="#ffffff" filter="url(#whiteNeonGlow)">G</text>

    <!-- ================= TENGELYRE IGAZÍTOTT 3D BETŰK ÉS VEKTOROK ================= -->
    <g font-family="Courier New, monospace" font-size="13" font-weight="bold" fill="#00f2ff" text-anchor="middle" filter="url(#subtleGlow)">
      <!-- BAL FELSŐ SAROK -> "A" VEKTOR -->
      <path d="M -195,-195 L -175,-195 L -195,-175 Z" fill="#00f2ff" opacity="0.4" filter="url(#neonGlow)" />
      <text x="-160" y="-145" filter="url(#neonGlow)">A</text>

      <!-- JOBB FELSŐ SAROK -> "B" VEKTOR -->
      <path d="M 195,-195 L 175,-195 L 195,-175 Z" fill="#00f2ff" opacity="0.4" filter="url(#neonGlow)" />
      <text x="160" y="-145" filter="url(#neonGlow)">B</text>

      <!-- JOBB ALSÓ SAROK -> "E" VEKTOR -->
      <path d="M 195,195 L 175,195 L 195,175 Z" fill="#00f2ff" opacity="0.4" filter="url(#neonGlow)" />
      <text x="160" y="160" filter="url(#neonGlow)">E</text>

      <!-- BAL ALSÓ SAROK -> "N" VEKTOR -->
      <path d="M -195,195 L -175,195 L -195,175 Z" fill="#00f2ff" opacity="0.4" filter="url(#neonGlow)" />
      <text x="-160" y="160" filter="url(#neonGlow)">N</text>
    </g>

  </g>
</svg>
